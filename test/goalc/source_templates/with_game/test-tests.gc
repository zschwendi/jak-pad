(start-test "test-of-test")


(expect-eq 1 2)
(expect-eq 1 3 :name "test")
(expect-eq 5 5)

(finish-test)

(let ((response (new 'stack-no-clear 'load-dgo-msg)))
  (when (!= (dgo-load-response-state (the-as load-dgo-msg #f)) 'pending)
    (format #t "DGO no-response state was not pending.~%"))
  (set! (-> response result) (load-msg-result error))
  (when (!= (dgo-load-response-state response) 'error)
    (format #t "DGO ERROR response was not terminal.~%"))
  (set! (-> response result) (load-msg-result aborted))
  (when (!= (dgo-load-response-state response) 'error)
    (format #t "DGO ABORTED response was not terminal.~%"))
  (set! (-> response result) (load-msg-result invalid))
  (when (!= (dgo-load-response-state response) 'error)
    (format #t "DGO invalid response was not terminal.~%"))
  (set! (-> response result) (load-msg-result more))
  (when (!= (dgo-load-response-state response) 'more)
    (format #t "DGO MORE response was not successful.~%"))
  (set! (-> response result) (load-msg-result done))
  (when (!= (dgo-load-response-state response) 'done)
    (format #t "DGO DONE response was not successful.~%")))
