(defun test-vector-div-q-bits ((numerator uint) (denominator uint))
  (let ((vector-in-1 (new 'stack 'vector))
        (vector-in-2 (new 'stack 'vector))
        (vector-out (new 'stack 'vector)))
    (set! (-> (the-as (pointer uint32) vector-in-1) 0) numerator)
    (set! (-> (the-as (pointer uint32) vector-in-2) 0) denominator)
    (rlet ((vf1 :class vf :reset-here #t)
           (vf2 :class vf :reset-here #t)
           (vf3 :class vf :reset-here #t))
      (.lvf vf1 vector-in-1)
      (.lvf vf2 vector-in-2)
      (.div.vf vf3 vf1 vf2 :fsf #b0 :ftf #b0)
      (.svf vector-out vf3))
    (format #t "#x~X~%" (-> (the-as (pointer uint32) vector-out) 0))))

(test-vector-div-q-bits #x3f800000 #x80000000)
(test-vector-div-q-bits #x80000000 #x00000000)
(test-vector-div-q-bits #x00000001 #x3f800000)
(test-vector-div-q-bits #x3f800000 #x00000001)
(test-vector-div-q-bits #x7f800000 #x3f800000)
(test-vector-div-q-bits #x40c00000 #x40800000)
(test-vector-div-q-bits #x7f7fffff #x00800000)
(test-vector-div-q-bits #x00800000 #x7f7fffff)
