;; AOT-only direct symbol-value read for the *load-state* binding used by
;; load-state wrappers in goal_src/jak1/engine/level/load-boundary.gc.
;; The emitted Mach-O code reads the live GOAL symbol value through the
;; signed S7-relative binding displacement; it does not define a shadow value.
(deftype load-state (basic)
  ()
  :no-runtime-type
  :no-inspect)

(define-extern *load-state* load-state)

(defun load-state-value ()
  *load-state*)
