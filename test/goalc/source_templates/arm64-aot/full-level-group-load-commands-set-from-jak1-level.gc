;; AOT-only direct function form of the exact body of
;; level-group::load-commands-set! in goal_src/jak1/engine/level/level.gc.
;; This does not install or replace the runtime method.
;; This is only the prefix required to preserve the raw #x24 load-commands field;
;; the basic-pointer bias makes its effective GOAL pointer-relative offset #x20.
(deftype level-group (basic)
  ((pad uint8 32)
   (load-commands pair :offset #x24 :offset-assert #x24))
  :no-runtime-type
  :no-inspect)

(defun level-group-load-commands-set! ((this level-group) (load-commands pair))
  (set! (-> this load-commands) load-commands)
  load-commands)
