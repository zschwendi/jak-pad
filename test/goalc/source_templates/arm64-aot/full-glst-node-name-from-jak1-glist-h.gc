;; AOT-only minimal type layout from goal_src/jak1/engine/util/glist-h.gc.
(deftype glst-node (structure)
  ((next glst-node :offset-assert 0)
   (prev glst-node :offset-assert 4))
  :size-assert #x8
  :no-runtime-type
  :no-inspect)

(deftype glst-named-node (glst-node)
  ((privname string :offset-assert 8))
  :size-assert #xc
  :no-runtime-type
  :no-inspect)

;; Exact full definition from goal_src/jak1/engine/util/glist-h.gc.
(defun glst-node-name ((arg0 glst-named-node))
  "Return the name of the node"
  (-> arg0 privname))
