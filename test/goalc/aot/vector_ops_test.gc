(defun aot-test-ppach ((dst (pointer uint128)) (a (pointer uint128)) (b (pointer uint128)))
  "Built by goalc out of halfword shuffles, byte shifts and pcpyld, so it exercises all of them."
  (local-vars (va uint128) (vb uint128) (vd uint128))
  (set! va (-> a 0))
  (set! vb (-> b 0))
  (.ppach vd va vb)
  (set! (-> dst 0) vd)
  (none))

