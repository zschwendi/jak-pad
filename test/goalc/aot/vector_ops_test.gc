(defun aot-test-blend ((dst (pointer uint128)) (a (pointer uint128)) (b (pointer uint128)) (mask int))
  "Blend with a run-time mask is not expressible, so branch over the four single-lane masks the
   .blend.vf.x/y/z/w macros produce. Lane i of the result must come from b exactly when bit i is
   set."
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 a)
    (.lvf vf2 b)
    (cond
      ((= mask 1) (.blend.vf.x vf1 vf1 vf2))
      ((= mask 2) (.blend.vf.y vf1 vf1 vf2))
      ((= mask 4) (.blend.vf.z vf1 vf1 vf2))
      (else (.blend.vf.w vf1 vf1 vf2)))
    (.svf dst vf1))
  (none))

(defun aot-test-outer-product ((dst (pointer uint128)) (a (pointer uint128)) (b (pointer uint128)))
  "The cross product goalc builds out of .swizzle.vf and .blend.vf. A wrong swizzle control order
   gives a wrong cross product, which is checkable against arithmetic the C side does itself."
  (rlet ((vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf))
    (.lvf vf1 dst)
    (.lvf vf2 a)
    (.lvf vf3 b)
    (.outer.product.vf vf1 vf2 vf3)
    (.svf dst vf1))
  (none))

(defmacro aot-test-cross-vf (out a b)
  `(begin
     (.outer.product.a.vf acc ,a ,b)
     (.outer.product.b.vf ,out ,b ,a acc)))

(defun aot-test-merc-matrix
    ((dst pointer) (joint pointer) (bone pointer) (camera pointer))
  "The vector-assembly core of Jak II's new-bones-mtx-calc-asm. This keeps its split outer
   products, determinant reduction, scalar divide, and camera multiplies together in one portable
   AOT contract."
  (rlet ((tmat0 :class vf)
         (tmat1 :class vf)
         (tmat2 :class vf)
         (tmat3 :class vf)
         (nmat0 :class vf)
         (nmat1 :class vf)
         (nmat2 :class vf)
         (nmat3 :class vf)
         (cam0 :class vf)
         (cam1 :class vf)
         (cam2 :class vf)
         (cam3 :class vf)
         (acc :class vf))
    (.lvf tmat0 joint)
    (.lvf tmat1 (&+ joint 16))
    (.lvf tmat2 (&+ joint 32))
    (.lvf tmat3 (&+ joint 48))
    (.lvf nmat0 bone)
    (.lvf nmat1 (&+ bone 16))
    (.lvf nmat2 (&+ bone 32))
    (.lvf nmat3 (&+ bone 48))
    (.lvf cam0 camera)
    (.lvf cam1 (&+ camera 16))
    (.lvf cam2 (&+ camera 32))
    (.lvf cam3 (&+ camera 48))

    (.mul.x.vf acc nmat0 tmat0)
    (.add.mul.y.vf acc nmat1 tmat0 acc)
    (.add.mul.z.vf acc nmat2 tmat0 acc)
    (.add.mul.w.vf tmat0 nmat3 tmat0 acc)
    (.mul.x.vf acc nmat0 tmat1)
    (.add.mul.y.vf acc nmat1 tmat1 acc)
    (.add.mul.z.vf acc nmat2 tmat1 acc)
    (.add.mul.w.vf tmat1 nmat3 tmat1 acc)
    (.mul.x.vf acc nmat0 tmat2)
    (.add.mul.y.vf acc nmat1 tmat2 acc)
    (.add.mul.z.vf acc nmat2 tmat2 acc)
    (.add.mul.w.vf tmat2 nmat3 tmat2 acc)
    (.mul.x.vf acc nmat0 tmat3)
    (.add.mul.y.vf acc nmat1 tmat3 acc)
    (.add.mul.z.vf acc nmat2 tmat3 acc)
    (.add.mul.w.vf tmat3 nmat3 tmat3 acc)

    (aot-test-cross-vf nmat0 tmat1 tmat2)
    (aot-test-cross-vf nmat1 tmat2 tmat0)
    (aot-test-cross-vf nmat2 tmat0 tmat1)
    (.mul.vf acc nmat0 tmat0)
    (.add.y.vf.x acc acc acc)
    (.add.z.vf.x acc acc acc)
    (.div.vf acc cam3 acc :fsf #b11 :ftf #b0)
    (.mul.x.vf nmat0 nmat0 acc)
    (.mul.x.vf nmat1 nmat1 acc)
    (.mul.x.vf nmat2 nmat2 acc)

    (.mul.x.vf acc cam0 tmat0)
    (.add.mul.y.vf acc cam1 tmat0 acc)
    (.add.mul.z.vf acc cam2 tmat0 acc)
    (.add.mul.w.vf tmat0 cam3 tmat0 acc)
    (.mul.x.vf acc cam0 tmat1)
    (.add.mul.y.vf acc cam1 tmat1 acc)
    (.add.mul.z.vf acc cam2 tmat1 acc)
    (.add.mul.w.vf tmat1 cam3 tmat1 acc)
    (.mul.x.vf acc cam0 tmat2)
    (.add.mul.y.vf acc cam1 tmat2 acc)
    (.add.mul.z.vf acc cam2 tmat2 acc)
    (.add.mul.w.vf tmat2 cam3 tmat2 acc)
    (.mul.x.vf acc cam0 tmat3)
    (.add.mul.y.vf acc cam1 tmat3 acc)
    (.add.mul.z.vf acc cam2 tmat3 acc)
    (.add.mul.w.vf tmat3 cam3 tmat3 acc)

    (.svf dst tmat0)
    (.svf (&+ dst 16) tmat1)
    (.svf (&+ dst 32) tmat2)
    (.svf (&+ dst 48) tmat3)
    (.mul.x.vf acc cam0 nmat0)
    (.add.mul.y.vf acc cam1 nmat0 acc)
    (.add.mul.z.vf nmat0 cam2 nmat0 acc)
    (.mul.x.vf acc cam0 nmat1)
    (.add.mul.y.vf acc cam1 nmat1 acc)
    (.add.mul.z.vf nmat1 cam2 nmat1 acc)
    (.mul.x.vf acc cam0 nmat2)
    (.add.mul.y.vf acc cam1 nmat2 acc)
    (.add.mul.z.vf nmat2 cam2 nmat2 acc)
    (.svf (&+ dst 64) nmat0)
    (.svf (&+ dst 80) nmat1)
    (.svf (&+ dst 96) nmat2))
  (none))

(defun aot-test-wait-nop ((dst (pointer uint128)) (a (pointer uint128)) (b (pointer uint128)))
  "VU0 macro-mode sync around a real computation. The C backend emits nothing for the barriers, so
   the sum still has to come out right."
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 a)
    (.lvf vf2 b)
    (.nop.vf)
    (.add.vf vf1 vf1 vf2)
    (.wait.vf)
    (.nop.vf)
    (.svf dst vf1))
  (none))

(defun aot-test-sqrt ((dst (pointer uint128)) (a (pointer uint128)))
  (rlet ((vf1 :class vf))
    (.lvf vf1 a)
    (.sqrt.vf vf1 vf1 :ftf #b10)
    (.svf dst vf1))
  (none))

(defun aot-test-inverse-sqrt
    ((dst (pointer uint128)) (numerator (pointer uint128)) (denominator (pointer uint128)))
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 numerator)
    (.lvf vf2 denominator)
    (.isqrt.vf vf1 vf1 vf2 :fsf #b1 :ftf #b10)
    (.svf dst vf1))
  (none))
