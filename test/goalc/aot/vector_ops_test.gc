;; Fixture for the AOT C backend's PS2 vector and 128-bit integer operations.
;;
;; These are lane-exact operations: a wrong lane order or the wrong signedness still compiles and
;; still runs, and only shows up as corrupted geometry or physics. So every function here is
;; called from process_c_backend_test's sibling, vector_ops_c_backend_test.c, with values chosen so
;; that each lane, each byte and each sign is distinguishable in the result.

(defun aot-test-pcpyld ((dst (pointer uint128)) (a (pointer uint128)) (b (pointer uint128)))
  (local-vars (va uint128) (vb uint128) (vd uint128))
  (set! va (-> a 0))
  (set! vb (-> b 0))
  (.pcpyld vd va vb)
  (set! (-> dst 0) vd)
  (none))

